{
	"name": "obsidian-pomodoro-flashcards",
	"version": "1.0.3",
	"description": "Obsidian plugin for creating and displaying flashcards with an integrated Pomodoro timer",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "esbuild test/srs-parser.test.ts --bundle --platform=node --format=cjs | node"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"flashcards",
		"spaced-repetition",
		"pomodoro"
	],
	"author": "blursedperf",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "0.21.5",
		"obsidian": "^1.5.7",
		"tslib": "2.6.2",
		"typescript": "5.4.5"
	}
}
